# Confluence API Configuration
# ==============================

# Confluence Page ID to extract
# Find this in the URL: https://tpgtelecom.atlassian.net/wiki/pages/<PAGE_ID>
CONFLUENCE_PAGE_ID=9399541499729

# Confluence base URL
CONFLUENCE_URL=https://tpgtelecom.atlassian.net/wiki

# Your Confluence account email
CONFLUENCE_EMAIL=your-email@tpgtelecom.com

# API Token for authentication
# Generate from: https://id.atlassian.com/manage/api-tokens
CONFLUENCE_TOKEN=your-api-token-here
